<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- who am I: children inherit groupId + version from here -->
    <groupId>patmal.workshops.student.impl</groupId>
    <artifactId>root</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>   <!-- builds no jar, only organizes -->

    <!-- aggregator role: what to build -->
    <modules>
        <module>core</module>
        <module>app</module>
    </modules>

    <!-- parent role: settings every child inherits -->
    <properties>
        <patmal.api.version>2.0</patmal.api.version>
        <commons-validator.version>1.10.0</commons-validator.version>
        <log4j.version>2.25.2</log4j.version>
        <jackson.version>2.20.0</jackson.version>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>patmal.workshops.student.impl</groupId>
                <artifactId>model-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>patmal.workshops.student.impl</groupId>
                <artifactId>logic-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>patmal.workshops</groupId>
                <artifactId>model</artifactId>
                <version>${patmal.api.version}</version>
            </dependency>
            <dependency>
                <groupId>patmal.workshops</groupId>
                <artifactId>logic</artifactId>
                <version>${patmal.api.version}</version>
            </dependency>
            <!--email validator-->
            <dependency>
                <groupId>commons-validator</groupId>
                <artifactId>commons-validator</artifactId>
                <version>${commons-validator.version}</version>
            </dependency>
            <!-- log4j-->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-bom</artifactId>
                <version>${log4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--            jackson-->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>
</project>